# Endereço do site (sem https://). Registros A no registro.br apontando para 2.24.79.129.
# Porta interna do app (o proxy do servidor encaminha o domínio para 127.0.0.1:PORTA_APP)
PORTA_APP=3010
DOMINIO=calculonamao.com.br

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Número do agente no WhatsApp, com DDI, só dígitos (ex.: 5532988887777)
AGENTE_WHATSAPP=
# Ligar (true) quando o pagamento estiver funcionando
EXIGIR_ASSINATURA=false

# Páginas de termos e privacidade
EMPRESA_CNPJ=
EMAIL_PRIVACIDADE=

# IA (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Agente do WhatsApp. AGENT_API_KEY é a mesma chave configurada no n8n.
AGENT_API_KEY=
VERIFICACAO_SEGREDO=
# Evolution no outro VPS
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=orcai

# Menu do WhatsApp como botões/lista (sim) em vez de texto numerado
WHATSAPP_BOTOES=
# Chatwoot (opcional): passar a conversa para um atendente
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
