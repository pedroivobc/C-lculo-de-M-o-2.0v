# Copie para infra/.env e preencha. Gere segredos com: openssl rand -hex 32

# Domínios (apontar os 3 registros A para o IP da VPS antes de subir)
DOMINIO_APP=app.seudominio.com.br
DOMINIO_N8N=n8n.seudominio.com.br
DOMINIO_EVOLUTION=evo.seudominio.com.br
# Usuário e senha na frente do editor do n8n e da Evolution (hash: docker compose run --rm caddy caddy hash-password).
# No .env, escreva cada $ do hash como $$ para o docker compose não tentar ler como variável.
PAINEL_USUARIO=
PAINEL_SENHA_HASH=

# Nome da vertical (marca Orçaí + segmento)
MARCA_NOME=Orça.ai Imob

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Segredos internos
AGENT_API_KEY=
VERIFICACAO_SEGREDO=
EVOLUTION_API_KEY=
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Número do agente (com DDI, só dígitos), mostrado no app
AGENTE_WHATSAPP=
# true quando o pagamento online existir: bloqueia o app sem assinatura ativa
EXIGIR_ASSINATURA=false

# Evolution
EVOLUTION_INSTANCE=agente
# EVOLUTION_IMAGE=atendai/evolution-api:v2.2.3

# Menu do WhatsApp como botões/lista (sim) em vez de texto numerado
WHATSAPP_BOTOES=
# Chatwoot (opcional): passar a conversa para um atendente
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
