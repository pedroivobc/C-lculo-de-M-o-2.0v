# Copie para infra/.env e preencha. Gere segredos com: openssl rand -hex 32

# Domínios (apontar os 3 registros A para o IP da VPS antes de subir)
DOMINIO_APP=app.seudominio.com.br
DOMINIO_N8N=n8n.seudominio.com.br
DOMINIO_EVOLUTION=evo.seudominio.com.br

# Nome comercial (troque quando o rebranding for decidido)
MARCA_NOME=Cálculo na Mão

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Segredos internos
AGENT_API_KEY=
VERIFICACAO_SEGREDO=
EVOLUTION_API_KEY=
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Evolution
EVOLUTION_INSTANCE=agente
# EVOLUTION_IMAGE=atendai/evolution-api:v2.2.3
