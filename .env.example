# Desenvolvimento local: copie para .env e rode `npm run dev`.
# Em produção (VPS), use infra/.env.example.

APP_URL=http://localhost:3000
MARCA_NOME=Orçaí Imob

# Supabase (Project Settings > API). As VITE_* vão para o navegador; a service role fica só no servidor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Número do agente (com DDI, só dígitos) e trava de assinatura (ligar quando o pagamento existir)
VITE_AGENTE_WHATSAPP=
VITE_EXIGIR_ASSINATURA=false
# Termos e privacidade: CNPJ de quem opera o serviço e e-mail para pedidos da LGPD.
VITE_EMPRESA_CNPJ=
VITE_EMAIL_PRIVACIDADE=
SUPABASE_SERVICE_ROLE_KEY=

# IA — só no servidor (não vai mais para o bundle do navegador)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Agente WhatsApp
AGENT_API_KEY=
VERIFICACAO_SEGREDO=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=agente

# Stripe: chave secreta (sk_test_ no teste) e segredo do webhook (whsec_). Ver infra/app-servidor/.env.example.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Menu com botões/lista no WhatsApp (sim) ou texto numerado (vazio). Teste no número do agente antes de ligar.
WHATSAPP_BOTOES=
# Chatwoot (opcional): abre e marca a conversa quando o corretor pede um atendente
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
