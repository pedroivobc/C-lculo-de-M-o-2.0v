{
  "name": "Agente WhatsApp · orçamentos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-agente",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "0b7c6a10-0001-4c2e-9a01-000000000001",
      "name": "Evolution: mensagem recebida",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "evolution-agente"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o evento MESSAGES_UPSERT da Evolution v2.\nconst corpo = $input.first().json.body ?? $input.first().json;\nconst evento = String(corpo.event ?? '').toLowerCase().replace('_', '.');\nconst d = corpo.data ?? {};\nconst key = d.key ?? {};\nconst m = d.message ?? {};\n\nconst ehCliente = evento === 'messages.upsert'\n  && key.fromMe !== true\n  && String(key.remoteJid ?? '').endsWith('@s.whatsapp.net');\nif (!ehCliente) return [];\n\nconst texto = m.conversation\n  ?? m.extendedTextMessage?.text\n  ?? m.imageMessage?.caption\n  ?? m.documentMessage?.caption\n  ?? m.documentWithCaptionMessage?.message?.documentMessage?.caption\n  ?? '';\nconst temMidia = !!(m.imageMessage || m.documentMessage || m.documentWithCaptionMessage);\nif (!texto && !temMidia) return []; // áudio, figurinha, reação etc.\n\nreturn [{ json: {\n  remoteJid: key.remoteJid,\n  numero: String(key.remoteJid).split('@')[0],\n  messageId: key.id,\n  nome: d.pushName ?? null,\n  texto,\n  temMidia,\n} }];"
      },
      "id": "0b7c6a10-0002-4c2e-9a01-000000000002",
      "name": "Filtrar e extrair",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_INTERNAL_URL }}/api/agente/mensagem",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-agent-key", "value": "={{ $env.AGENT_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ remoteJid: $json.remoteJid, messageId: $json.messageId, nome: $json.nome, texto: $json.texto, temMidia: $json.temMidia }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "0b7c6a10-0003-4c2e-9a01-000000000003",
      "name": "Perguntar ao agente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "respostas",
        "options": {}
      },
      "id": "0b7c6a10-0004-4c2e-9a01-000000000004",
      "name": "Uma resposta por vez",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.tipo }}",
              "rightValue": "texto",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b7c6a10-0005-4c2e-9a01-000000000005",
      "name": "É texto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_INTERNAL_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" } ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Filtrar e extrair').first().json.numero, text: $json.texto, delay: 800 }) }}",
        "options": {}
      },
      "id": "0b7c6a10-0006-4c2e-9a01-000000000006",
      "name": "Enviar texto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_INTERNAL_URL }}/message/sendMedia/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" } ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Filtrar e extrair').first().json.numero, mediatype: String($json.mimetype).startsWith('image/') ? 'image' : 'document', mimetype: $json.mimetype, media: $json.url, fileName: $json.nomeArquivo, caption: $json.legenda ?? '' }) }}",
        "options": {}
      },
      "id": "0b7c6a10-0007-4c2e-9a01-000000000007",
      "name": "Enviar PDF ou planilha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 100]
    }
  ],
  "connections": {
    "Evolution: mensagem recebida": { "main": [[{ "node": "Filtrar e extrair", "type": "main", "index": 0 }]] },
    "Filtrar e extrair": { "main": [[{ "node": "Perguntar ao agente", "type": "main", "index": 0 }]] },
    "Perguntar ao agente": { "main": [[{ "node": "Uma resposta por vez", "type": "main", "index": 0 }]] },
    "Uma resposta por vez": { "main": [[{ "node": "É texto?", "type": "main", "index": 0 }]] },
    "É texto?": {
      "main": [
        [{ "node": "Enviar texto", "type": "main", "index": 0 }],
        [{ "node": "Enviar PDF ou planilha", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
